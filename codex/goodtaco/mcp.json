{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "goodtaco": {
      "type": "streamable-http",
      "url": "https://server.goodtaco.ai/mcp/connector",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "oidcEnabled": true,
            "oidcScopesSupported": [
              "openid",
              "email"
            ]
          }
        }
      }
    }
  }
}
